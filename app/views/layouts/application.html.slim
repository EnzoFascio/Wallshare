doctype html
html
  head
    title WallShare
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    = javascript_importmap_tags

  body.bg-light
    nav.navbar.navbar-expand-lg.bg-white.shadow-sm.rounded-bottom-4.mb-4
      .container
        = link_to "🐬 WallShare", root_path, class: "navbar-brand fw-bold text-primary fs-4"

        button.navbar-toggler type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
          span.navbar-toggler-icon

        .collapse.navbar-collapse#navbarNav
          ul.navbar-nav.me-auto
            li.nav-item = link_to "Home", root_path, class: "nav-link"
            li.nav-item = link_to "Posts", posts_path, class: "nav-link"

          .d-flex.gap-2
            - if user_signed_in?
              span.navbar-text.me-2
                | Olá, #{current_user.email}
              = link_to "Sair", destroy_user_session_path, 
                data: { turbo_method: :delete, turbo_confirm: "Tem certeza que deseja sair?" }, 
                class: "btn btn-sm btn-outline-danger rounded-pill px-3"
            - else
              = link_to "Entrar", new_user_session_path, class: "btn btn-primary"
              = link_to "Registrar", new_user_registration_path, class: "btn btn-outline-primary"
              
    .container.mt-4
      = yield
